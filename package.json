{
  "publisher": "YunYouJun",
  "name": "valaxy",
  "displayName": "Valaxy",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "description": "Valaxy support for VS Code",
  "author": "YunYouJun <me@yunyoujun.cn>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/YunYouJun",
  "homepage": "https://valaxy.site/ecosystem/vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/valaxyjs/valaxy-vscode"
  },
  "bugs": {
    "url": "https://github.com/valaxyjs/valaxy-vscode/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/YunYouJun"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.js",
  "icon": "res/logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "valaxy.addPost",
        "category": "Valaxy",
        "title": "Add a Post",
        "icon": "$(add)"
      },
      {
        "command": "valaxy.refreshPosts",
        "category": "Valaxy",
        "title": "Refresh Posts",
        "icon": "$(refresh)"
      },
      {
        "command": "valaxy.preview-refresh",
        "category": "Valaxy",
        "title": "Preview Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "valaxy.delete-post",
        "category": "Valaxy",
        "title": "Delete Post",
        "icon": "$(trash)"
      },
      {
        "command": "valaxy.openSettings",
        "category": "Valaxy",
        "title": "Open Extension Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "valaxy.openBrowser",
        "category": "Valaxy",
        "title": "Open Browser Preview",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "valaxy.addPost",
          "when": "view == valaxy-posts",
          "group": "navigation@1"
        },
        {
          "command": "valaxy.refreshPosts",
          "when": "view =~ /valaxy-posts/",
          "group": "navigation"
        },
        {
          "command": "valaxy.preview-refresh",
          "when": "view =~ /valaxy-preview/",
          "group": "navigation"
        },
        {
          "command": "valaxy.openSettings",
          "when": "view == valaxy-preview",
          "group": "navigation"
        },
        {
          "command": "valaxy.openBrowser",
          "when": "view == valaxy-preview",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "valaxy.delete-post",
          "when": "view == valaxy-posts && viewItem == valaxy-post",
          "group": "inline@1"
        },
        {
          "command": "valaxy.delete-post",
          "when": "view == valaxy-posts && viewItem == valaxy-post"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Valaxy",
      "properties": {
        "valaxy.enabled": {
          "type": "boolean",
          "scope": "resource",
          "description": "Force enable extension",
          "default": false
        },
        "valaxy.port": {
          "type": "number",
          "scope": "resource",
          "description": "The port of Valaxy server",
          "default": 4859,
          "minimum": 1,
          "maximum": 65535
        },
        "valaxy.postsFolder": {
          "type": "string",
          "scope": "resource",
          "description": "The folder of your posts",
          "default": "pages/posts"
        },
        "valaxy.confirmDelete": {
          "type": "boolean",
          "scope": "resource",
          "description": "Confirm before deleting a post",
          "default": true
        },
        "valaxy.serverUrl": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Optional local server URL including a base path, for example http://localhost:4859/blog/. Overrides valaxy.port."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "valaxy",
          "title": "Valaxy",
          "icon": "res/logo.svg",
          "when": "valaxy-enabled"
        }
      ]
    },
    "views": {
      "valaxy": [
        {
          "id": "valaxy-posts",
          "name": "Valaxy Posts",
          "when": "valaxy-enabled"
        },
        {
          "type": "webview",
          "id": "valaxy-preview",
          "name": "Preview",
          "when": "valaxy-enabled"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "vscode:prepublish": "pnpm build",
    "pack": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:integration": "pnpm build && node test/integration/run.cjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm run pack"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.0.0",
    "@types/ejs": "3.1.5",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "ejs": "6.0.1",
    "eslint": "^9.39.0",
    "gray-matter": "4.0.3",
    "tsup": "8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  }
}
